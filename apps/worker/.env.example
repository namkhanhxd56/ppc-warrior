# ===== Cấu hình chống Amazon từ chối serve ads (ToS "?") =====

# Dùng binary Google Chrome THẬT cài trên máy (fingerprint thật hơn Chromium bundled).
# Không có Chrome → tự fallback. Muốn tắt: đặt CHROME_CHANNEL=chromium (giá trị sai bất kỳ)
CHROME_CHANNEL=chrome

# HEADFUL=1: Chrome CÓ GIAO DIỆN, cửa sổ đẩy ngoài màn hình (an toàn chống bot NHẤT,
#            nhưng trên macOS vẫn thấy icon Chrome trên Dock).
# HEADFUL=0: headless THẾ HỆ MỚI (puppeteer 22+) — chạy ngầm HOÀN TOÀN, không cửa sổ/icon;
#            fingerprint gần headful. Nếu thấy ToS "?" nhiều hơn → quay lại HEADFUL=1.
HEADFUL=1

# Chỉ dùng khi HEADFUL=0: kích thước MÀN HÌNH khai báo (screen.width/height). Chrome headless
# mặc định báo 800x600 — NHỎ HƠN cửa sổ 1366 nên lộ ngay là máy ảo (màn hình không thể bé hơn
# cửa sổ). Đặt bằng độ phân giải THẬT của máy agent. Mặc định trong code: 1470x956.
# SCREEN_INFO=1470x956

# Profile Chrome RIÊNG, BỀN VỮNG cho worker (./data/chrome-profile) — phiên có "tuổi thọ",
# Amazon tin hơn. KHÔNG phải profile Chrome cá nhân của bạn (tránh Previously-viewed).
# Nếu nghi profile bị "bẩn" (nhiều ⚠PV): xóa thư mục data/chrome-profile là làm mới.
# Tắt (phiên sạch mỗi lần): xóa dòng này hoặc để trống
WORKER_PROFILE=1

# Chặn tải image/media/font để chạy nhanh + tiết kiệm băng thông.
# ⚠️ MẶC ĐỊNH TẮT: phiên tải HTML mà không bao giờ tải ảnh là tín hiệu bot mạnh
# phía server Amazon. Chỉ bật (=1) nếu chấp nhận tỷ lệ "?" cao hơn.
# BLOCK_ASSETS=1

# ===== AGENT (máy cá nhân — chạy "npm run agent") =====
# Server team trên Railway; agent kéo job về chạy ngầm trên máy này rồi đẩy kết quả lên.
# SERVER_URL=https://xxx.up.railway.app
# AGENT_USER=ten-dang-nhap      # tài khoản đã đăng ký trên server (job/data vào phân vùng user này)
# AGENT_PASSWORD=mat-khau
# WORKER_PASSWORD=trung-voi-mat-khau-tren-railway
# AGENT_NAME=ten-cua-ban
# POLL_INTERVAL_MS=15000

# ===== VPS =====
# Mật khẩu bảo vệ UI khi VPS mở port ra internet (không đặt = không hỏi, chạy local như cũ).
# Trình duyệt hiện hộp đăng nhập: user gõ gì cũng được, password = giá trị này.
# WORKER_PASSWORD=doi-mat-khau-nay

# HEADFUL=1 vẫn dùng được trên VPS (không có màn hình) nhờ màn hình ảo xvfb:
# chạy bằng "npm run start:vps" thay vì "npm start" (setup-vps.sh đã cấu hình pm2 sẵn)

# WORKER_PORT=3100
# MAX_PAGES=3
